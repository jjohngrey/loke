        "id",
        "concept_id",
        "kind",
        "text",
        "occurred_at",
        "assessment",
        "assistance",
        "source"
      ],
      "title": "EvidenceEvent",
      "type": "object"
    },
    "GoalInput": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "goal": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Goal",
          "type": "string"
