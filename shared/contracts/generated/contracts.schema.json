    "RunEvent": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "session_epoch": {
          "title": "Session Epoch",
          "type": "integer"
