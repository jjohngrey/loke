# PostgreSQL is required. Start it with docker compose up -d.
DATABASE_URL=postgresql+psycopg://loke:loke@127.0.0.1:5432/loke
MODEL_MODE=demo
OPENROUTER_API_KEY=
OPENROUTER_PROVIDER=OpenAI
TEXT_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe-2025-12-15
BACKEND_URL=http://127.0.0.1:8000
SESSION_TOKEN=local-demo-change-me
DEMO_LEARNER_ID=demo-learner
DEMO_CLOCK_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# Memory compaction/partition maintenance, independent of 30-second review ticks.
MEMORY_MAINTENANCE_INTERVAL_SECONDS=900

MEMORY_SUMMARY_TRIGGER_MESSAGES=100
MEMORY_RECENT_MESSAGES=40
MEMORY_LEAF_RECORD_LIMIT=200
MEMORY_LEAF_TOKEN_LIMIT=12000
MEMORY_CONTEXT_TOKEN_LIMIT=3000
